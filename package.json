{
  "name": "winnow",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "agent-native dev --no-prewarm",
    "typecheck": "pnpm -r typecheck",
    "repair:workspace-org": "tsx scripts/repair-workspace-org.ts",
    "skills:update": "agent-native skills update scaffold --project",
    "upgrade:agent-native": "agent-native upgrade",
    "fmt:check": "oxfmt --check .",
    "lint": "pnpm fmt:check",
    "eval": "pnpm --filter qualify eval",
    "test": "pnpm --filter qualify --filter scheduler --filter forms -r test"
  },
  "dependencies": {
    "@agent-native/core": "0.114.16",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.34",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "oxfmt": "catalog:",
    "tsx": "catalog:",
    "typescript-7": "catalog:"
  },
  "packageManager": "pnpm@10.14.0",
  "agent-native": {
    "workspaceCore": "@winnow/shared"
  },
  "description": "Winnow - scores and routes inbound sales leads, gated by a 24-case model eval suite"
}
