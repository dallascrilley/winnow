<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Forgotten-down guard for Winnow interview mode.
  Install (from repo root):
    infra/install-interview-expiry-agent.sh
  Uninstall:
    launchctl bootout gui/$(id -u) ~/Library/LaunchAgents/com.dallas.inbound-interview-expiry.plist
    rm -f ~/Library/LaunchAgents/com.dallas.inbound-interview-expiry.plist
  Logs:
    ~/.hub/logs/inbound-interview-expiry.launchd.log
  Paths below are placeholders; install-interview-expiry-agent.sh rewrites
  __REPO_ROOT__, __HOME__, and __LOG_DIR__ for the installing machine.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dallas.inbound-interview-expiry</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO_ROOT__/infra/check-expiry-notify.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__</string>
  <!-- Every 30 minutes -->
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>AbandonProcessGroup</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/inbound-interview-expiry.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/inbound-interview-expiry.launchd.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__HOME__/.local/bin:__HOME__/.local/share/mise/shims:__HOME__/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>AWS_REGION</key>
    <string>us-east-1</string>
    <key>INBOUND_EXPIRY_NTFY_TOPIC</key>
    <string>agent_alerts</string>
  </dict>
</dict>
</plist>
